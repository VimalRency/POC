void writeLog(char action[])
{
    FILE *fp;

    time_t now;

    fp = fopen("auditlog.dat","a");

    if(fp == NULL)
    {
        return;
    }

    now = time(NULL);

    fprintf(fp,
            "%s : %s",
            action,
            ctime(&now));

    fclose(fp);
}HR Login Success : Mon Oct 26 06:58:02 2026
